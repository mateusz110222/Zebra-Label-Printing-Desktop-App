# Haslo administratora PostgreSQL (inicjalizacja i utrzymanie).
POSTGRES_PASSWORD=
# Haslo konta API zapisujacego dane stanowisk.
INGEST_DB_PASSWORD=
# Haslo konta odczytu danych IT.
IT_DB_PASSWORD=
# Haslo konta odczytu ograniczonych danych Produkcji.
PRODUCTION_DB_PASSWORD=
# Haslo techniczne inicjalizacji Grafany; nie sluzy do logowania w panelu.
GRAFANA_ADMIN_PASSWORD=
# Przypieta wersja obrazu Grafany.
GRAFANA_IMAGE=grafana/grafana:13.3.0
PUBLIC_URL=http://monitoring.example.com:8083/
HTTP_PORT=8083
LDAP_URL=ldaps://ldap.example.com:3269
LDAP_LOGIN_DOMAIN=example.com
LDAP_DOMAIN=
LDAP_SEARCH_BASE=DC=example,DC=com
LDAP_TIMEOUT_MS=5000
LDAP_CONNECT_TIMEOUT_MS=3000
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_TLS_ALLOW_LEGACY_SERVER_CERT=false
# CA chain is still verified; only SAN/CN hostname matching is skipped.
LDAP_TLS_SKIP_HOSTNAME_VERIFICATION=true
LDAP_CA_CERT_PATH=certs/company-enterprise-root.pem
LDAP_IT_DEPARTMENTS='IT'
LDAP_IT_GROUP_DN=
