LDAP_URL=ldaps://ldap.example.com:3269
LDAP_LOGIN_DOMAIN=example.com
LDAP_DOMAIN=
LDAP_SEARCH_BASE=DC=example,DC=com
LDAP_TIMEOUT_MS=5000
LDAP_CONNECT_TIMEOUT_MS=3000
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_TLS_ALLOW_LEGACY_SERVER_CERT=false
# The CA chain is still verified; only SAN/CN hostname matching is skipped.
LDAP_TLS_SKIP_HOSTNAME_VERIFICATION=true
LDAP_CA_CERT_PATH=certs/company-enterprise-root.pem
LDAP_IT_DEPARTMENTS=IT
LDAP_IT_GROUP_DN=
# Exact LDAP department values allowed to configure the printer.
LDAP_UR_DEPARTMENTS=
MYSQL_TLS_REJECT_UNAUTHORIZED=false
MYSQL_SSL_REJECT_UNAUTHORIZED=false
MYSQL_CA_CERT_PATH=
PARTS_CONFIG_URL=https://example.com/router.php?job=GetConfig
PARTS_CONFIG_FILE=lps.json
GITHUB_RELEASE_URL=https://api.github.com/repos/example-owner/example-repo/releases/latest
